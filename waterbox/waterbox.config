  "settings": [
    {
      "name": "release",
      "display": "setting.release",
      "type": "enum",
      "options": [
        "floppy",
        "download"
      ],
      "default": "floppy",
      "description": "setting.release.about"
    },
    {
      "name": "sound",
      "display": "setting.sound",
      "type": "enum",
      "options": [
        "roland",
        "adlib",
        "speaker",
        "tandy",
        "none"
      ],
      "default": "roland",
      "description": "setting.sound.about"
    },
    {
      "name": "skip_title",
      "display": "setting.skip_title",
      "type": "bool",
      "default": false,
      "description": "setting.skip_title.about"
    },
    {
      "name": "random_seed",
      "display": "setting.random_seed",
      "type": "string",
      "default": "0",
      "description": "setting.random_seed.about"
    },
    {
      "name": "clock_start",
      "display": "setting.clock_start",
      "type": "string",
      "default": "1989-10-25 12:00:00",
      "description": "setting.clock_start.about"
    }
  ],
